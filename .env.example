# All values belong to the NEW shop. Never copy the original shop's credentials.
GP_SITE_URL=http://localhost:3001
GP_SHOP_ID=girl-prints
# Demo is on until you explicitly enable real products and payments.
GP_DEMO_MODE=true
GP_CHECKOUT_ENABLED=false
GP_STRIPE_SECRET_KEY=
GP_STRIPE_WEBHOOK_SECRET=
# Enable Stripe Tax in the new Stripe account before checkout.
GP_STRIPE_AUTOMATIC_TAX=true
GP_SUPABASE_URL=
GP_SUPABASE_SERVICE_ROLE_KEY=
GP_RESEND_API_KEY=
GP_RESEND_FROM=
GP_CONTACT_EMAIL=
GP_ORDER_NOTIFY_EMAIL=
# Random secret used to hash contact rate-limit identifiers.
GP_RATE_LIMIT_SECRET=
